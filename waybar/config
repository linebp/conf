{
  "layer": "top",
  "spacing": 10,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-center": [
    "wlr/taskbar"
  ],
  "modules-right": [
    "load",
    "memory",
    "bluetooth",
    "pulseaudio",
    "battery",
    "power-profiles-daemon",
    "gamemode",
    "clock",
    "tray",
    "custom/power"
  ],
  "load": {
    "format": " {load1}"
  },
  "memory": {
    "format": " {percentage}%",
    "tooltip-format": "(GiB)\tTotal\tUsed\tAvail\nMem\t{total}\t{used}\t{avail}\t{percentage}%\nSwap\t{swapTotal}\t{swapUsed}\t{swapAvail}\t{swapPercentage}%"
  },  
  "wlr/taskbar": {
    "format": "{icon} {name}",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },  
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "gamemode": {
    "format": "{glyph}",
    "format-alt": "{glyph} {count}",
    "glyph": "",
    "use-icon": true,
    "icon-name": "input-gaming-symbolic",
    "icon-spacing": 4,
    "icon-size": 20,
    "tooltip": true,
    "tooltip-format": "Games running: {count}"
  },  
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format-discharging": "{icon} {capacity}% 󱐤",
    "format": "{icon} {capacity}% 󱐥",
    "format-icons": ["󱊡", "󱊢", "󱊣"],
    
    "full-at": 96,
    "max-length": 25,
    "tooltip-format": "{timeTo}"
  },
  "sway/workspaces": {
    "format": "{icon}",
    "sort-by-number": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": ["Easy Effects Sink"]
  },
  "sway/mode": {
    "format": "{}",
    "max-length": 50
  },
  "tray": {
    "spacing": 10
  },
  "bluetooth": {
    "format": " {num_connections}",
    "format-disabled": "",
    "format-connected": " {num_connections}",    
    "tooltip-format": "{controller_alias}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias:.20}\t󰥊",
    "tooltip-format-enumerate-connected-battery": "{device_alias:.20}\t󰥈 {device_battery_percentage}%"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode"          : "year",
      "mode-mon-col"  : 3,
      "weeks-pos"     : "right",
      "on-scroll"     : 1,
      "format": {
        "months":     "<span color='#f1fa8c'><b>{}</b></span>",
        "days":       "<span color='#f8f8f2'><b>{}</b></span>",
        "weeks":      "<span color='#8be9fd'><b>W{}</b></span>",
        "weekdays":   "<span color='#ffb86c'><b>{}</b></span>",
        "today":      "<span color='#bd93f9'><b><u>{}</u></b></span>"
      }
    },
    "actions":  {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },  
  "custom/power": {
    "format":"⏻",
    "on-click": "exec ~/.config/waybar/scripts/power-menu.sh",
    "tooltip": false
  }
}
